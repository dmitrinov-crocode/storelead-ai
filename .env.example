# Copy to .env and fill in. STORELEADS_API_KEY is required to fetch stores,
# PAGESPEED_API_KEY to run the pagespeed step.

NODE_ENV=development

# StoreLeads — the one paid subscription the project needs.
STORELEADS_API_KEY=
STORELEADS_API_URL=https://storeleads.app/json/api/v1/all

# OpenAI API — агенты Epic 3–5 обращаются к модели напрямую.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Требуется только для user-level ключа (`sk-…`), видящего несколько проектов:
# ключ `sk-proj-…` уже несёт свой проект. Задаёт заголовок OpenAI-Project.
OPENAI_PROJECT_ID=

# Google PageSpeed Insights. Required for the pagespeed step: a keyless call now
# answers 429 with quota_limit_value 0 (checked 2026-09-01). Free key:
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
# Reuse a stored result for this many days instead of asking again.
PAGESPEED_CACHE_DAYS=7
# Stop-loss on one run's PageSpeed requests, mobile + desktop counted separately.
PAGESPEED_MAX_REQUESTS_PER_RUN=200

# Storage (relative paths resolve against the project root).
DATABASE_PATH=data/database.sqlite
SCREENSHOTS_DIR=screenshots
LOG_DIR=data/logs

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Pipeline
BATCH_SIZE=10
STORE_CONCURRENCY=2
TARGET_COUNTRY=PL
# Leave empty to fetch every platform; the audit checks are Shopify-shaped.
TARGET_PLATFORM=shopify

# Politeness towards audited storefronts
REQUEST_DELAY_MS=1000
PAGE_TIMEOUT_MS=30000

# AI — ceiling for the fact bundle handed to the agents, in bytes of JSON.
AI_CONTEXT_MAX_BYTES=32000

# Web search for contacts (tasks 4-05…4-07). It runs on OPENAI_API_KEY above —
# that is why the OpenAI web_search tool was picked over Serper and Exa: no new
# account, no new secret. Roughly $10 per 1000 searches.
WEB_SEARCH_ENABLED=true
# Blank falls back to OPENAI_MODEL. The search runner copies out a result list
# and reasons about nothing, so a cheaper model belongs here when one exists.
OPENAI_WEB_SEARCH_MODEL=
# Queries per store, spent only on stores whose own pages named nobody.
WEB_SEARCH_MAX_QUERIES_PER_STORE=2
# Stop-loss for one run, in billable searches — about a dollar at the default.
WEB_SEARCH_MAX_SEARCHES_PER_RUN=100

# How long a contact may be kept, in days (task 4-11). Contacts are personal data
# of EU citizens; `pipeline contacts purge` deletes anything older.
CONTACT_RETENTION_DAYS=180

# How the contact scraper identifies itself to shops (task 7-06). A URL or an
# email a merchant can use to reach you; it goes into the User-Agent as
# `StoreLeadBot/0.1 (+<contact>)`. The audit keeps a browser user agent — it has
# to see the storefront the way a shopper does.
CRAWLER_CONTACT=
