{
  "name": "storelead-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agents for identifying problems on websites based on criteria",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "pipeline": "tsx src/cli/index.ts",
    "db:migrate": "tsx src/cli/index.ts db migrate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "test": "tsx --test \"src/**/*.test.ts\" \"apps/dashboard/src/**/*.test.ts\"",
    "verify": "npm run typecheck && npm run lint && npm run lint --workspace apps/dashboard && npm test && npm run build --workspace apps/dashboard",
    "dashboard": "npm run dev --workspace apps/dashboard"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "openai": "^7.10.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  }
}
